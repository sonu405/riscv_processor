WORKFLOW_OPERATION simulation,dialog;

DEFINE_MEMORY_TYPE dmem_bram_32K_2_MEM_DEVICE [0x00008000] 32;
DEFINE_MEMORY_TYPE imem_bram_32K_2_MEM_DEVICE [0x00008000] 32;

ADDRESS_MAP processing_system7_0 ARM 100 processing_system7_0
   ADDRESS_SPACE dmem_bram_32K_2_ADDR_SPACE dmem_bram_32K_2_MEM_DEVICE  [0x40000000:0x40007FFF] dmem_ctrl
     BUS_BLOCK
      dmem_bram_32K_2_BUS_BLK [31:0] INPUT = "system_bd_dmem_bram_0.mem";
     END_BUS_BLOCK;
   END_ADDRESS_SPACE;
   ADDRESS_SPACE imem_bram_32K_2_ADDR_SPACE imem_bram_32K_2_MEM_DEVICE  [0x42000000:0x42007FFF] imem_ctrl
     BUS_BLOCK
      imem_bram_32K_2_BUS_BLK [31:0] INPUT = "system_bd_imem_bram_0.mem";
     END_BUS_BLOCK;
   END_ADDRESS_SPACE;
END_ADDRESS_MAP;
