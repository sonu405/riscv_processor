    <MODULE COREREVISION="14" FULLNAME="/imem_ctrl" HWVERSION="4.1" INSTANCE="imem_ctrl" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="MEMORY_CNTLR" MODTYPE="axi_bram_ctrl" VLNV="xilinx.com:ip:axi_bram_ctrl:4.1">
